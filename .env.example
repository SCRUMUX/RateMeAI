# --- API_BASE_URL (важно для медиа в Telegram) ---
# app и worker: укажите ПУБЛИЧНЫЙ URL API (https://...), по которому Telegram сможет скачать
#   файлы из /storage/... (карточки рейтинга, сгенерированные CV/emoji). Localhost не виден Telegram.
# bot (docker-compose): в compose обычно переопределяется на http://app:8000 для запросов к API внутри сети.
# См. README.md — таблица «Компонент / Что должен видеть».

# === Telegram ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# === OpenRouter (LLM) ===
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# === Database ===
DATABASE_URL=postgresql+asyncpg://ratemeai:ratemeai@localhost:5432/ratemeai

# === Redis ===
REDIS_URL=redis://localhost:6379/0
# API stages each upload here for the worker (must be the same Redis as ARQ)
TASK_INPUT_REDIS_TTL_SECONDS=3600

# === Storage ===
# local: общий volume между app/worker/bot (см. docker-compose). В облаке без общего диска — s3.
# В docker-compose путь принудительно /app/storage для всех сервисов (игнор Windows-путей из .env).
# WORKER: при отсутствии файла на диске — запрос к API /storage/... (в compose задаётся автоматически).
STORAGE_HTTP_FALLBACK_BASE=
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ratemeai
S3_REGION=auto
# Публичный базовый URL объектов (CDN / public bucket) или пусто для presigned URL
S3_PUBLIC_BASE_URL=
# TTL presigned ссылок; держите с запасом до показа результата пользователю
S3_PRESIGN_TTL_SECONDS=3600

# Image generation for CV/dating/social/emoji.
# Actual prod path: ``unified`` — UnifiedImageGen wraps the FAL queue
# clients for GPT Image 2 + Nano Banana 2 (whichever the AB router
# picks per request). Use ``mock`` for local dev / CI. Anything else
# the factory currently treats as a synonym of ``unified`` (kept for
# rollback compatibility; see ``src/providers/factory.py``).
IMAGE_GEN_PROVIDER=unified

# === FAL.ai (sole image-gen vendor) ===
# Получить ключ: https://fal.ai → Dashboard → Keys (формат: <uuid>:<secret>).
# НИКОГДА не коммитить реальный ключ — .env игнорируется git'ом, храним только здесь.
# При ротации / компрометации ключа — сразу удалять его в FAL Dashboard → Keys → Revoke.
FAL_API_KEY=

# --- Common FAL parameters (apply to every FAL queue client) ---
FAL_API_HOST=https://queue.fal.run
FAL_OUTPUT_FORMAT=jpeg
FAL_MAX_RETRIES=2
FAL_REQUEST_TIMEOUT=180
FAL_POLL_INTERVAL=1.5

# === YooKassa Payments ===
# Shop ID и секретный ключ из личного кабинета ЮKassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
# URL возврата после оплаты (по умолчанию ссылка на бота)
YOOKASSA_RETURN_URL=https://t.me/RateMeAI_bot
# Пакеты кредитов RUB (edge / ЮKassa): количество:цена через запятую
# Должно совпадать с лендингом (5/10/20/50 фото).
CREDIT_PACKS=5:227,10:427,20:727,50:1527

# === Xsolla (primary / global, USD) ===
# Merchant API + Pay Station. На edge переменные должны быть пустыми.
# Webhook URL для кабинета Xsolla (Settings → Webhooks):
#   https://app-production-6986.up.railway.app/api/v1/payments/xsolla/webhook
# (НЕ ставить домен фронтенда — это Vercel SPA, она вернёт HTML 404 и
# Xsolla заблокирует payments на user_validation.)
XSOLLA_MERCHANT_ID=
XSOLLA_PROJECT_ID=
XSOLLA_API_KEY=
# Подпись вебхуков: SHA1(body + secret). По умолчанию берётся XSOLLA_API_KEY.
XSOLLA_WEBHOOK_SECRET=
XSOLLA_RETURN_URL=https://ailookstudio.ru/payment-success
# Sandbox-режим Pay Station. true = токены выдаются без активации
# проекта в Publisher Account (тестовая карта 4111 1111 1111 1111).
# Когда проект активирован — поставить false для прод-платежей.
XSOLLA_SANDBOX_MODE=false
CREDIT_PACKS_USD=5:3.27,10:5.27,20:8.27,50:19.27

# B2B admin bootstrap (set ADMIN_SECRET to enable POST /api/v1/auth/api-client)
ADMIN_SECRET=
API_KEY_PEPPER=

# === Identity Gate (VLM-based, no local face embeddings) ===
# Identity match is scored 0-10 by the quality-gate VLM comparing
# original vs generated. Hard gate = identity_match_threshold (images
# below are marked quality_warning). Soft warning boundary below.
IDENTITY_MATCH_THRESHOLD=7.0
IDENTITY_MATCH_SOFT_THRESHOLD=5.0

# Retry budget cap when ``IDENTITY_RETRY_ENABLED=true`` (default 1).
IDENTITY_RETRY_MAX_ATTEMPTS=1

# v1.17 — GFPGAN face pre-clean. When ON, run fal-ai/gfpgan on
# clearly-blurry inputs (Laplacian thresholds in
# src/services/face_prerestore.py) before the main FLUX pass.
# Costs ~$0.002 per *applied* case. v1.17.1: default ON — the adaptive
# 1 MP full-body branch depends on downstream upscaling, so keeping
# this disabled left blurry inputs strictly worse. Provider failures
# fold back to the original bytes — never load-bearing.
GFPGAN_PRECLEAN_ENABLED=true
GFPGAN_MODEL=fal-ai/gfpgan
MODEL_COST_FAL_GFPGAN=0.002

# v1.17 — Real-ESRGAN final upscale. When ON, replace the local PIL
# LANCZOS x2 upscale in _apply_local_postprocess with a diffusion-aware
# fal-ai/real-esrgan pass (only when face_area_ratio >= 0.15).
# LANCZOS remains the automatic fallback on any provider failure.
# Costs ~$0.002 per applied case. v1.17.1: default ON — without it the
# adaptive 1 MP full-body branch produces visibly softer faces than the
# previous 2 MP LANCZOS path.
REAL_ESRGAN_ENABLED=true
REAL_ESRGAN_MODEL=fal-ai/real-esrgan
MODEL_COST_FAL_REAL_ESRGAN=0.002

# === Active image-gen route: GPT Image 2 Edit (single FAL provider) ===
# Every ``/analyze`` request goes through GPT Image 2 Edit. The Nano
# Banana 2 backend and the cross-model fallback layer were retired —
# transient FAL failures are absorbed by the in-pipeline identity
# retry with a fresh seed on the same model. The ``tier`` form field
# (standard / premium) decides whether the Clarity Upscaler post-pass
# runs; the legacy ``AB_DEFAULT_MODEL`` env knob is kept as a no-op
# label so older deploy configs do not 5xx on the missing setting.
AB_TEST_ENABLED=true
AB_DEFAULT_MODEL=gpt_image_2
AB_DEFAULT_QUALITY=medium
AB_PROMPT_MAX_LEN=2000
# Identity-retry on the active FAL path. GPT Image 2 does not expose
# PuLID-style identity knobs, so the retry mainly rerolls the seed —
# keep off unless investigating an identity regression. The historical
# ``AB_IDENTITY_RETRY_ENABLED`` env name is still accepted via a
# pydantic alias for older deploy configs.
IDENTITY_RETRY_ENABLED=false

# === Style schema feature flags (legacy emergency rollback knobs) ===
# Every style in ``data/styles.json`` ships at ``schema_version: 3`` and
# the v2 / v3 loaders are always-on in production. These flags remain
# only as emergency rollback levers — flipping any to ``false`` will
# disable the corresponding prompt-path branch but is NOT exercised in
# CI. Phase 3 of the cleanup roadmap will retire them.
STYLE_SCHEMA_V2_ENABLED=true
UNIFIED_PROMPT_V2_ENABLED=true
VARIATION_ENGINE_V2_ENABLED=true

# Nano Banana 2 Edit was retired in the "Remove Nano Banana, Premium
# Upscale" cleanup — its env knobs (NANO_BANANA_MODEL,
# MODEL_COST_FAL_NANO_BANANA_*) are no longer read. The pipeline now
# runs on a single image model (see GPT_IMAGE_2_MODEL below).

# GPT Image 2 Edit (OpenAI ChatGPT Images 2.0 via fal).
# https://fal.ai/models/openai/gpt-image-2/edit
# Low=1024², Medium=1536², High=2048² (square outputs).
GPT_IMAGE_2_MODEL=openai/gpt-image-2/edit
MODEL_COST_GPT_IMAGE_2_LOW=0.02
MODEL_COST_GPT_IMAGE_2_MEDIUM=0.06
MODEL_COST_GPT_IMAGE_2_HIGH=0.25

# === Pipeline budget ===
PIPELINE_BUDGET_MAX_USD=0.15

# === Quality Gates ===
AESTHETIC_THRESHOLD=6.0
# config.py default is 0.15; set lower for stricter artifact detection
ARTIFACT_THRESHOLD=0.15
PHOTOREALISM_ENABLED=true
PHOTOREALISM_THRESHOLD=0.5

# === Scoring ===
SCORING_TEMPERATURE=0.0
# Number of LLM calls to average for scoring (1 = single call, 3 = consensus)
SCORING_CONSENSUS_SAMPLES=1

# === Rate Limits ===
RATE_LIMIT_DAILY=3
# Telegram username(s) без дневного лимита, через запятую, без @
RATE_LIMIT_EXEMPT_USERNAMES=scrumux

# === OK Mini App ===
OK_APP_ID=
OK_APP_SECRET_KEY=
OK_APP_PUBLIC_KEY=

# === VK Mini App ===
VK_APP_ID=
VK_APP_SECRET=
VK_SERVICE_TOKEN=

# === Yandex ID OAuth ===
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# === VK ID OAuth (web site login) ===
VK_ID_APP_ID=
VK_ID_APP_SECRET=

# === Google OAuth (foreign users, main domain only) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Phone SMS OTP ===
# Provider: log (dev, prints to console) | sms_aero | twilio
SMS_PROVIDER=log
SMS_AERO_API_KEY=
SMS_AERO_EMAIL=
SMS_AERO_SIGN=AI Look

# === WhatsApp Business API ===
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# === Sessions ===
# TTL for Bearer session tokens (web / mini apps), seconds
SESSION_TTL_SECONDS=86400

# === Geo-split Deployment ===
# Mode: primary (Railway, full AI processing) | edge (RU server, proxies AI to Railway)
DEPLOYMENT_MODE=primary
# Explicit product/runtime topology (recommended to set in every deployed service)
# MARKET_ID: global | ru | ...
MARKET_ID=global
# SERVICE_ROLE: api | worker | bot | web
SERVICE_ROLE=api
# COMPUTE_MODE: local | remote
COMPUTE_MODE=local
# URL of the primary Railway API (only needed in edge mode)
REMOTE_AI_BACKEND_URL=
# Shared secret for /internal/* endpoints between edge↔primary (set on BOTH servers)
INTERNAL_API_KEY=
# URL of the RU edge server — bot on Railway uses it for RUB payments/balance (set on Railway bot service)
EDGE_API_URL=
# Primary Railway API URL — bot uses it for USD (Xsolla) checkout sessions (same Bearer регистрация на primary)
PRIMARY_API_URL=
# Сосед для кросс-серверного /storage fallback.
# На primary: URL edge-сервера (https://ai-look-studio.ru).
# На edge: URL primary (https://api.ailookstudio.com).
# Оставить пустым, чтобы выключить fallback и вернуть legacy-поведение.
EDGE_PEER_URL=

# === RU Edge Auto-deploy (GitHub Actions secrets) ===
# Set these as GitHub repository secrets for automated RU deploys on push to main:
#   RU_SSH_HOST  — IP or hostname of the RU edge server
#   RU_SSH_USER  — SSH username (e.g. root)
#   RU_SSH_KEY   — Private SSH key (ed25519 or rsa) for passwordless access
# If RU_SSH_HOST or RU_SSH_KEY are missing, the deploy-ru job is skipped gracefully.

# === CORS ===
# Extra allowed origins for mini apps (comma-separated). Auto-added to CORS in prod.
CORS_EXTRA_ORIGINS=

# === CMS replication (Variant B) ===
# Single CMS hub on Railway. ``editor`` accepts admin writes and pushes
# every successful save to the configured followers; ``follower`` (RU
# edge) refuses admin writes (HTTP 403) and only mutates the on-disk
# JSON via the signed receiver / hourly safety-pull.
CMS_ROLE=editor
# Comma-separated list of follower base URLs (editor only).
# Example: https://ailookstudio.ru
CMS_FOLLOWER_URLS=
# Master CMS URL (follower only). Example: https://app-production-6986.up.railway.app
CMS_MASTER_URL=
# HMAC-SHA256 shared secret for replication payloads. Reuses
# ``INTERNAL_API_KEY`` when empty (no extra rotation required for the
# initial rollout).
CMS_REPLICATION_SECRET=
# Disable to turn off the hourly follower safety-pull cron.
CMS_SAFETY_PULL_ENABLED=true

# === App ===
# Необязательно: короткий SHA коммита (в CI), смотреть в GET /health и в логах при старте
DEPLOY_GIT_SHA=
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
API_BASE_URL=http://localhost:8000
# Public URL of the web SPA (for share links, payment return URLs).
# Variant B: ``ailookstudio.vercel.app`` on Railway, ``ailookstudio.ru`` on RU edge.
WEB_BASE_URL=https://ailookstudio.vercel.app
# URL лендинга, который бот показывает в сообщениях ("Зайди на сайт …")
# и из которого собирает /privacy для consent-кнопки. Можно отдельно
# от WEB_BASE_URL — например, RU-бот всегда указывает на ailookstudio.ru,
# а Global-бот на ailookstudio.vercel.app. Если пусто, fallback —
# WEB_BASE_URL (а если и он пуст — хардкод "ailookstudio.ru").
BOT_WEB_LANDING_URL=https://ailookstudio.vercel.app

# === Web App (Vite SPA) ===
# API endpoint the frontend calls (set in Railway web service env).
# Global build (Vercel): https://app-production-6986.up.railway.app
# RU build (nginx on VPS): leave empty so the SPA uses the relative ``/api`` proxy.
VITE_API_BASE_URL=https://app-production-6986.up.railway.app
# Explicit market for frontend build. If empty, web falls back to hostname detection.
VITE_MARKET_ID=global
# Public origin of this SPA build — drives canonical / og:url / hreflang
# in ``useDocumentMeta`` without baking domain literals into source code.
VITE_WEB_ORIGIN=https://ailookstudio.vercel.app
# Public support email shown in SupportModal / AccountBlockedScreen / policies.
VITE_SUPPORT_EMAIL=support@ailookstudio.ru
# Custom domain for the web service (legacy hint; used by docs only).
WEB_DOMAIN=ailookstudio.vercel.app
TELEGRAM_BOT_USERNAME=YourBotUsername
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=
